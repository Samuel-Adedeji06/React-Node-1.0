    <h3 style="text-decoration: underline;">User List</h3> <br>
    
    <div style="background-color: aqua; color: crimson; padding: 20px;" >
        <% allCustomers.map((customer) => { %>
            <h4> Firstname: <%= customer.firstname %></h4>
            <h4> Email: <%= customer.email %></h4>
            <h4> Password: <%= customer.password %></h5>
            <hr>
        <% }) %> 
    </div>
</body>
