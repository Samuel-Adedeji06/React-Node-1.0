<body style="padding: 40px 400px;">

    <h1 style="text-align: center;">SignUp Page</h1> <br>
    <form action="/register" method="POST">
        <input type="text" class="form-control"  placeholder="First name" name="firstname"> <br> <br>      
        <input type="text" class="form-control"  placeholder="Email" name="email"> <br> <br>
